# Copy to .env (git-ignored) and fill in. Loaded automatically in development.

# Twilio WhatsApp confirmations — use live credentials, not Twilio's "Test Credentials".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number in +E.164 format, without the "whatsapp:" prefix (Sandbox: +14155238886).
TWILIO_WHATSAPP_FROM=
